# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection string. With Supabase: Project → Connect → Connection string → URI.
#   - Serverless hosting (e.g. Vercel): the Transaction pooler (port 6543).
#   - Your own server or local development: the Session pooler (port 5432).
# Migrations automatically use the session pooler when this is the transaction pooler.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Signs session cookies. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# The website address, used in email links, the sitemap and link previews.
NEXT_PUBLIC_SITE_URL=https://impulsevidya.in

# Resend (https://resend.com/api-keys). Without a key, emails are printed to the server console.
RESEND_API_KEY=
# Must use a domain verified in Resend. onboarding@resend.dev only delivers to your own address.
EMAIL_FROM=ImpulseVidya <onboarding@resend.dev>

# The admin (mentor) account. When the server starts, this account is created if it doesn't
# exist. An existing account keeps its password; change it from the Profile page.
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
